{
  "name": "waifu-billing-system",
  "version": "1.0.0",
  "description": "外服账单系统桌面版",
  "author": "外服账单系统",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:verify": "set NEXT_DIST_DIR=.next-verify&& next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "build:desktop": "node desktop/build-desktop.cjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.0",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-dropdown-menu": "2.1.1",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-progress": "1.1.0",
    "@radix-ui/react-select": "2.1.1",
    "@radix-ui/react-separator": "1.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tabs": "1.1.0",
    "@swc/helpers": "0.5.5",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.428.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^2.12.7",
    "sonner": "1.5.0",
    "tailwind-merge": "2.4.0",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.waifu.billing",
    "productName": "外服账单系统",
    "executableName": "外服账单系统",
    "directories": {
      "output": "../release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "frontend"
      },
      {
        "from": "../dist/外服账单系统后端",
        "to": "backend"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "外服账单系统"
    }
  }
}
