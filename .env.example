# Development defaults only. Copy to .env and replace secrets locally.
PAYROLL_DATABASE_URL=sqlite:///backend/data/payroll.db
PAYROLL_JWT_SECRET=replace-with-a-long-random-secret
PAYROLL_ENV=development
PAYROLL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional document-agent model (OpenAI-compatible chat completions).
# Leave unset to run deterministic preflight/manual review only.
PAYROLL_MODEL_PROVIDER=openai_compatible
PAYROLL_MODEL_BASE_URL=https://api.openai.com/v1
PAYROLL_MODEL_API_KEY=replace-with-model-api-key
PAYROLL_MODEL_NAME=replace-with-model-name
PAYROLL_MODEL_API_STYLE=responses
PAYROLL_MODEL_REASONING_EFFORT=low
PAYROLL_MODEL_TIMEOUT_SECONDS=120
PAYROLL_MODEL_MAX_OUTPUT_TOKENS=512
PAYROLL_MODEL_ENABLE_THINKING=true

# Optional secondary Agent provider. When the primary model returns repeated
# errors, empty responses, timeouts, or malformed tool calls, the same run
# context is retried with this provider. Keep real keys in the local User env.
PAYROLL_MODEL_FALLBACK_PROVIDER=openai_compatible
PAYROLL_MODEL_FALLBACK_BASE_URL=https://api.deepseek.com/v1
PAYROLL_MODEL_FALLBACK_API_KEY=replace-with-fallback-api-key
PAYROLL_MODEL_FALLBACK_NAME=deepseek-reasoner
PAYROLL_MODEL_FALLBACK_API_STYLE=chat_completions
PAYROLL_MODEL_FALLBACK_REASONING_EFFORT=high
PAYROLL_MODEL_FALLBACK_TIMEOUT_SECONDS=180
PAYROLL_MODEL_FALLBACK_MAX_OUTPUT_TOKENS=8192
PAYROLL_MODEL_FALLBACK_ENABLE_THINKING=true

# Convenience aliases for DeepSeek (alternative to PAYROLL_MODEL_*).
# DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_FALLBACK_MODEL=deepseek-reasoner
